mpi_hello-world:
  build:
    files: '@SRCPATH@/mpi_hello-world.cu'
  group: GRPMPI
  run:
    cwd: .
    iterate:
      program:
        accl:
          local: False
          values: "--cuda"
mpi_reduce:
  build:
    files: '@SRCPATH@/mpi_reduce.cu'
  group: GRPMPI
  run:
    cwd: .
    iterate:
      program:
        accl:
          local: False
          values: "--cuda"
