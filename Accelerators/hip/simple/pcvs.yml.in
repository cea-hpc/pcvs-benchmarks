mpi_hello-world:
  build:
    files: '@SRCPATH@/mpi_hello-world.hip'
  group: GRPMPI
  run:
    cwd: .
    iterate:
      program:
        accl:
          local: False
          values: "--rocm"
mpi_reduce:
  build:
    files: '@SRCPATH@/mpi_reduce.hip'
  group: GRPMPI
  run:
    cwd: .
    iterate:
      program:
        accl:
          local: False
          values: "--rocm"
