#!/bin/sh

pcvs_gen_makefile() {

	echo "
NULL_STRING :=

LIB_PATH    =
LIBS        =
CC          = ${PCVS_CC}
CXX         = ${PCVS_CXX}
OPTFLAGS    = -O3 $1 -include stddef.h ${PCVS_CFLAGS}
CLINKER     = ${PCVS_CC}
LDFLAGS     =
CPPFLAGS    = -O3 $1 -include stddef.h ${PCVS_CXXFLAGS}

IMB-MPI1 = IMB-MPI1
IMB-EXT  = IMB-EXT
IMB-IO   = IMB-IO
IMB-NBC  = IMB-NBC
IMB-RMA  = IMB-RMA

export MPI_INCLUDE CC LIB_PATH LIBS OPTFLAGS CLINKER LDFLAGS CPPFLAGS IMB-MPI1 IMB-EXT IMB-IO IMB-NBC IMB-RMA
include Makefile.base
"
}

pcvs_echo_IMB_common() {
	cat <<EOF
compile_IMB:
  build:
    files: "@BUILDPATH@/Makefile"
    make:
      target: "all"
      jobs: true

.IMB-MPI1: &TMPI1
  depends_on:   [ "compile_IMB" ]
  program: "IMB-MPI1"

.IMB-EXT: &TEXT
  depends_on:   [ "compile_IMB" ]
  program: "IMB-EXT"

.IMB-IO: &TIO
  depends_on:   [ "compile_IMB" ]
  program: "IMB-IO"

.IMB-NBC: &TNBC
  depends_on:   [ "compile_IMB" ]
  program: "IMB-NBC"

.IMB-RMA: &TRMA
  depends_on:   [ "compile_IMB" ]
  program: "IMB-RMA"

.IMB-P2P: &TP2P
  depends_on:   [ "compile_IMB" ]
  program: "IMB-P2P"

EOF
}

pcvs_src_current="$pcvs_src/$1"
pcvs_build_current="$pcvs_testbuild/$1"

# copy IMB sources
cp -r $pcvs_src_current/src* $pcvs_build_current
cp $pcvs_src_current/Makefile* $pcvs_build_current

# Generate Makefile in build/
pcvs_gen_makefile "-DCHECK" >$pcvs_build_current/Makefile || exit 1

# Push "build" rules
pcvs_echo_IMB_common || exit 1

# Push "run" rules from ../IMB_LIST_OF_TESTS
while read l; do
	# skip empty lines and lines starting with comment '#'
	echo $l | egrep -q "^ *(#.*)*$"
	if test "$?" = "0"; then
		continue
	fi

	bin="$(echo $l | cut -f1 -d" " | sed 's/IMB-//g')"
	name="$(echo $l | cut -f2 -d" ")"
	cat <<EOF

${bin}_${name}:
  group: 'GRPMPI'
  tag: ['${bin}']
  run:
    <<: *T$bin
    iterate:
      program:
        args:
          values: "$name"
EOF
done <$pcvs_src_current/IMB_LIST_OF_TESTS
exit 0
