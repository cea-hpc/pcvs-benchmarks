run_mpitests$(EXEEXT): $(run_mpitests_OBJECTS) $(run_mpitests_DEPENDENCIES) $(EXTRA_run_mpitests_DEPENDENCIES) 
	@rm -f run_mpitests$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(run_mpitests_OBJECTS) $(run_mpitests_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f attr/*.$(OBJEXT)
	-rm -f coll/*.$(OBJEXT)
	-rm -f util/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

