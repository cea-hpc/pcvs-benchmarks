#!/bin/sh
# RMA-MT sources are available on https://github.com/hpc/rma-mt.git

pcvs_src_current=$pcvs_src/$1
pcvs_build_current=$pcvs_testbuild/$1

#pre actions...
OLDIR=$(pwd)
cd $pcvs_build_current
cp -r $pcvs_src_current/* $pcvs_build_current/

#run configure...
autoreconf -fi >autoreconf.log 2>&1 || exit 1
./configure CC="$PCVS_CMP_CC" CXX="$PCVS_CMP_CXX" CFLAGS="$PCVS_CMP_CC_ARGS -lpthread" --prefix=$pcvs_build_current >configure.log 2>&1

echo "compile_rma_mt:"
echo "    build:"
echo "        files: '@BUILDPATH@/Makefile'"
echo "        make:"
echo "            target: 'all'"
echo "            args: ['LDFLAGS=-lpthread']"

#add new tests here...
for bin in rmamt_bw rmamt_bibw rmamt_lat; do
	for numthreads in 1 4 64; do
		echo "${bin}-t$numthreads:"
		echo "    run:"
		echo "        program: 'src/$bin -i 10'"
		echo "        depends_on: [ \"compile_rma_mt\" ]"
		echo "        iterate:"
		echo "            cpu_bind: {values: null}"
		echo "            program:"
		echo "                th:"
		echo "                  option: '-t '"
		echo "                  subtitle: 't'"
		echo "                  values: [$numthreads]"
		echo "                sync:"
		echo "                  option: '-s '"
		echo "                  subtitle: ''"
		echo "                  values: ['lock', 'fence', 'pscw', 'lock_all', 'flush']"
		echo "                type:"
		echo "                  option: '-o '"
		echo "                  subtitle: ''"
		echo "                  values: ['put', 'get']"
		echo "            n_cores: {values: [$numthreads]}"

		case $bin in
		rmamt_lat)
			echo "            n_mpi: {values: [2]}"
			;;
		*)
			echo "            n_mpi: {values: [{from: 2, of: 2}]}"
			;;
		esac
	done
done

cd $OLDIR
exit 0
