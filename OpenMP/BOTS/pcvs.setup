#!/bin/sh
pcvs_src_current=$pcvs_src/$1
pcvs_build_current=$pcvs_testbuild/$1

cp -r $pcvs_src_current/* $pcvs_build_current/
mkdir $pcvs_build_current/bin

cat <<EOF > $pcvs_build_current/config/make.config

#Automatically generated by configure
#compilers and linkers

#config name
LABEL=pcvs

#compilers
OMPC=$PCVS_CMP_CC $PCVS_CMP_CC_VAR_OPENMP_ARGS
CC=$PCVS_CMP_CC
OMPLINK=$PCVS_CMP_CC $PCVS_CMP_CC_VAR_OPENMP_ARGS
CLINK=$PCVS_CMP_CC

#compiler and linker flags

OPT_FLAGS=-O3

CC_FLAGS=$PCVS_CMP_CC_ARGS
OMPC_FLAGS= 
OMPC_FINAL_FLAGS=

CLINK_FLAGS=
OMPLINK_FLAGS=
EXTRA_LIBS=

EOF

echo "build_bots:"
echo "  build:"
echo "    make: {'target': ''}"
echo "    files: '@BUILDPATH@/Makefile'"

for align in 'for' 'single'
do
	echo "alignment-$align:"
	echo "  group: 'GRPOMP'"
	echo "  run:"
	echo "    depends_on: ['build_bots']"
	echo "    program: 'bin/alignment.pcvs.$align-omp-tasks'"
	echo "    iterate: {'program': {'args': {'values': '-c -f @BUILDPATH@/inputs/alignment/prot.20.aa'}}}"
done

echo "fft_1024x1024x8:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/fft.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -n 8388608'}}}"

echo "fib_20:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/fib.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -n 20'}}}"

echo "floorplan_input20:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/floorplan.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -f @BUILDPATH@/inputs/floorplan/input.20'}}}"

echo "health_small:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/health.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -f @BUILDPATH@/inputs/health/small.input'}}}"

echo "nqueens_14:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/nqueens.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -n 14'}}}"

echo "sort_20:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    program: 'bin/sort.pcvs.omp-tasks'"
echo "    depends_on: ['build_bots']"
echo "    iterate: {'program': {'args': {'values': '-c -n 20'}}}"

for sparselu in 'for' 'single'
do
	echo "sparselu-${sparselu}_25:"
	echo "  group: 'GRPOMP'"
	echo "  run:"
	echo "    program: 'bin/sparselu.pcvs.$sparselu-omp-tasks'"
	echo "    depends_on: ['build_bots']"
	echo "    iterate: {'program': {'args': {'values': '-c -n 25'}}}"
done

echo "strassen_1024:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/strassen.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -n 1024'}}}"

echo "uts_tiny:"
echo "  group: 'GRPOMP'"
echo "  run:"
echo "    depends_on: ['build_bots']"
echo "    program: 'bin/uts.pcvs.omp-tasks'"
echo "    iterate: {'program': {'args': {'values': '-c -f @BUILDPATH@/inputs/uts/tiny.input'}}}"

exit 0
