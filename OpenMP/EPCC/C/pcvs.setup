#!/bin/sh

pcvs_src_current="$pcvs_src/$1"
pcvs_build_current="$pcvs_testbuild/$1"

cp -r $pcvs_src_current/* $pcvs_build_current
cat <<EOF
build_epcc:
  build:
    variants: [ 'openmp' ]
    files: "@BUILDPATH@/Makefile"
    make: {'target': "", jobs: false, args: ['-ik']}

.bench_run: &runt
  group: 'GRPOMP'
  run:
    depends_on:   [ "build_epcc" ]

arraybench_1:
  <<: *runt
arraybench_3:
  <<: *runt
arraybench_9:
  <<: *runt
arraybench_27:
  <<: *runt
arraybench_81:
  <<: *runt
arraybench_243:
  <<: *runt
arraybench_729:
  <<: *runt
arraybench_2187:
  <<: *runt
arraybench_6561:
  <<: *runt
arraybench_19683:
  <<: *runt
arraybench_59049:
  <<: *runt

schedbench:
  <<: *runt

taskbench:
  <<: *runt
EOF

exit 0
