basic_std_thread:
  build:
    files: '@SRCPATH@/basic.cpp'
    sources: {binary: 'basic_std_thread', cflags: '-lpthread'}
  run:
    iterate:
      n_node: {values: null}
      n_mpi: {values: null}
      n_omp: {values: null}
      n_proc: {values: null}
      net: {values: null}
  validate:
    time:
      hard_timeout: 120
simple_counter_std_thread:
  build:
    files: '@SRCPATH@/simple_counter.cpp'
    sources: {binary: 'simple_counter_std_thread', cflags: '-lpthread'}
  run:
    iterate:
      n_node: {values: null}
      n_mpi: {values: null}
      n_omp: {values: null}
      n_proc: {values: null}
      net: {values: null}
  validate:
    time:
      hard_timeout: 120
