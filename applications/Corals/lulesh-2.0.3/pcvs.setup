#!/bin/sh

pcvs_src_current=$pcvs_src/$1
pcvs_build_current=$pcvs_testbuild/$1

cp -r $pcvs_src_current/* $pcvs_build_current
echo "lulesh:
    build:
        variants: [ 'openmp' ]
        files: '@BUILDPATH@/Makefile'
        make:
            target: ''
            args: ['PCVS_CC=@COMPILER_CC@', 'PCVS_CXX=@COMPILER_CXX@']
            jobs: 16
    run:
        program: 'lulesh2.0'
        iterate:
            n_node:
                values: [1, 2, 4]
            n_mpi:
                values: {op: 'powerof', of: 3}
"

exit 0
