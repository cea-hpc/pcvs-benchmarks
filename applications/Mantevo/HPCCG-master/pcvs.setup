#!/bin/sh

prefix=$pcvs_testbuild/$1/

mkdir -p $prefix/serial $prefix/mpi

cp -r $pcvs_src/$1/* $prefix/

cat << EOF
HPCGG:
    build:
        files: '@BUILDPATH@/Makefile'
        make:
            args: [""]
    run:
        program: '@BUILDPATH@/test_HPCCG'
        iterate:
            program:
                nx:
                    type: "argument"
                    numeric: true
                    subtitle: "nx"
                    option: ""
                    values: [1]
                ny:
                    type: "argument"
                    numeric: true
                    subtitle: "ny"
                    option: ""
                    values: [1]
                nz:
                    type: "argument"
                    numeric: true
                    subtitle: "nz"
                    option: ""
                    values: [1]
EOF

exit 0
