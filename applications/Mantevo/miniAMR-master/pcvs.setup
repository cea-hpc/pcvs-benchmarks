#!/bin/sh

prefix=$pcvs_testbuild/$1/

mkdir -p $prefix/openmp $prefix/ref

cp -r $pcvs_src/$1/openmp $prefix
cp -r $pcvs_src/$1/ref $prefix

cat << EOF 
miniAMR_ref:
    group: "GRPSERIAL"
    build:
        files: '@BUILDPATH@/ref/Makefile'
        make:
            args: ['']
    run:
        iterate:
            n_mpi: 
                values: [1]
        program: '@BUILDPATH@/ref/miniAMR.x'
EOF

# This does not build with mpc or mpich

# miniAMR_openmp:
#     build:
#         variants: ['openmp']
#         files: '@BUILDPATH@/openmp/Makefile'
#         make:
#             args: ['']
#     run:
#         program: '@BUILDPATH@/openmp/miniAMR.x'
exit 0
