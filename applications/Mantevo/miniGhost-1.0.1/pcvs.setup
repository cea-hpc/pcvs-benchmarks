#!/bin/sh

prefix=$pcvs_testbuild/$1/

mkdir -p $prefix/serial $prefix/mpi

cp -r $pcvs_src/$1/* $prefix/serial
cp -r $pcvs_src/$1/* $prefix/mpi

cat << EOF 
miniGhost_serial:
    group: "GRPSERIAL"
    build:
        variants: ['openmp']
        files: '@BUILDPATH@/serial/ref/Makefile'
        make:
            args: ['PROTOCOL=-D_MG_SERIAL']
    run:
        program: '@BUILDPATH@/serial/ref/miniGhost.x'
        
miniGhost_parallel:
    group: "GRPMPI"
    build:
        variants: ['openmp']
        files: '@BUILDPATH@/mpi/ref/Makefile'
        make:
            args: ["PROTOCOL=-D_MG_MPI"]
    run:
        program: '@BUILDPATH@/mpi/ref/miniGhost.x --checkpoint_interval 1 --checkpoint_file checkpoint.minighost --restart_file checkpoint.minighost'
        iterate:
            n_mpi:
                values: [4]
            program:
                STENCIL:
                    type: "argument"
                    numeric: true
                    subtitle: "stencil"
                    option: "--stencil "
                    values: [21]
                NUM_VARS:
                    type: "argument"
                    numeric: true
                    subtitle: "numvars"
                    option: "--num_vars "
                    values: [40]
                SCALING:
                    type: "argument"
                    numeric: true
                    subtitle: "scaling"
                    option: "--scaling "
                    values: [1, 2]
                NPX:
                    type: "argument"
                    numeric: true
                    subtitle: "npx"
                    option: "--npx "
                    values: [2]
                NPY:
                    type: "argument"
                    numeric: true
                    subtitle: "npy"
                    option: "--npy "
                    values: [2]
                NPZ:
                    type: "argument"
                    numeric: true
                    subtitle: "npz"
                    option: "--npz "
                    values: [1]
                NX:
                    type: "argument"
                    numeric: true
                    subtitle: "nx"
                    option: "--nx "
                    values: [100]
                NY:
                    type: "argument"
                    numeric: true
                    subtitle: "ny"
                    option: "--ny "
                    values: [100]
                NZ:
                    type: "argument"
                    numeric: true
                    subtitle: "nz"
                    option: "--nz "
                    values: [100]
EOF

exit 0
