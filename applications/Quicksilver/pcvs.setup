#!/usr/bin/env python3
import os
import subprocess
import sys

subdir = sys.argv[1] if len(sys.argv) >= 2 else ""
cur_srcdir = os.path.join(os.environ["pcvs_src"], subdir)
cur_builddir = os.path.join(os.environ["pcvs_testbuild"], subdir)

if __name__ == "__main__":
    try:
        cmd = (
            f"cp -r {cur_srcdir}/Quicksilver/src/* {cur_builddir}"
            + f"&& sed -i '110,115d' {cur_builddir}/Makefile"
        )
        subprocess.check_output(cmd, shell=True)

        print(
            """
build_quicksilver:
    build:
        files: '@BUILDPATH@/Makefile'
        make:
            args: 
                - 'CXX="@COMPILER_CXX@"'
                - 'CXXFLAGS="-DHAVE_MPI -DHAVE_ASYNC_MPI -DHAVE_OPENMP -std=c++11 -O3 {}"'
        variants:
                - openmp
""".format(
                os.environ["PCVS_CMP_CXX_VAR_OPENMP_ARGS"]
            )
        )

        print(
            """
run_quicksilver:
    run:
        depends_on: ['build_quicksilver']
        program: '@BUILDPATH@/qs'
"""
        )

    except FileNotFoundError as e:
        print(f"{e} not found", file=sys.stderr)
        exit(1)
    except subprocess.CalledProcessError as e:
        print(f"Command {e.cmd} failed: {e.stderr}", file=sys.stderr)
        exit(2)
    exit(0)
