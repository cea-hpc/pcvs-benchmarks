#!/bin/bash

# NOTE: For now this configuration only supports some of the C tests
# If you want to expand it feel free to do so

pcvs_src_current=$pcvs_src/$1
pcvs_build_current=$pcvs_testbuild/$1

mpi_testsuite() {

	local pre_testsuite_dir=$(pwd)
	cd $pcvs_src_current/c/mpi

	# Go through all the test kinds
	local groups=$(find . -maxdepth 1 -type d -not -name '.*' | cut -c 3-)
	for group in $groups; do
		local subgroups=""
		local names=""

		# Build step
		echo "compile_osu_mpi_$group:"
		echo "  build:"
		echo "    files: '@BUILDPATH@/c/mpi/$group/Makefile'"
		echo "    make: {'target': 'all'}"
		echo ""

		# Special no subdirectory simple tests
		if [ $group == "startup" -o $group == "one-sided" ]; then
			names=$(find $group -maxdepth 1 -type f -name 'osu*' | cut -f 2 -d '/' | cut -f 1 -d '.')
			local tags="\"MPI\", \"$group\""
			for name in $names; do
				local binary="@BUILDPATH@/c/mpi/$group/$name"

				# Run step
				echo "${group}_${name}:"
				echo "  tag: [$tags]"
				echo "  group: 'GRPMPI'"
				echo "  run:"
				echo "    program: '${binary}'"
				echo "    depends_on:   [ 'compile_osu_mpi_$group' ]"

				# Special cases
				if [ $group == "one-sided" ]; then
					echo "    iterate: {'n_mpi': {'values': [2]}}"
				fi
				echo "  validate: {time: {hard_timeout: 600}}"
				echo ""

			done
		# Deeper tests
		else
			subgroups=$(find $group -maxdepth 1 -type d | cut -d '/' -f 2)
			for subgroup in $subgroups; do
				if [ $subgroup == $group ]; then
					continue
				fi

				local tags="\"MPI\", \"$group\", \"$subgroup\""
				names=$(find $group/$subgroup -maxdepth 1 -type f -name 'osu*' | cut -f 3 -d '/' | cut -f 1 -d '.')
				for name in $names; do
					local binary="@BUILDPATH@/c/mpi/$group/$subgroup/$name"
					# Run step
					echo "${group}_${subgroup}_${name}:"
					echo "  tag: [$tags]"
					echo "  group: 'GRPMPI'"
					echo "  run:"
					echo "    program: '${binary}'"
					echo "    depends_on:   [ 'compile_osu_mpi_$group' ]"

					# Special cases
					if [ $subgroup == "congestion" ]; then
						echo "    iterate: {'n_node': {'values': [{from: 2}]}}"
					elif [ $subgroup == "neighborhood" ]; then
						echo "    iterate: {'n_mpi': {'values': [{from: 4}]}}"
					elif [ $group == "pt2pt" ]; then
						echo "    iterate: {'n_mpi': {'values': [2]}}"
					else
						echo "    iterate: {'n_mpi': {'values': [{op: 'seq', from: 2}]}}"
					fi
					echo "  validate: {time: {hard_timeout: 600}}"
					echo ""
				done
			done
		fi

	done
	cd $pre_testsuite_dir
}

openshmem_testsuite() {

	local pre_testsuite_dir=$(pwd)
	cd $pcvs_src_current/c/openshmem

	local names=$(find . -maxdepth 1 -type f -name 'osu*' | cut -c 3- | cut -d '.' -f 1)
	for name in $names; do
		local tags

		if [ grep -Eo "put" $name != "" ]; then
			tags='"openshmem", "put"'
		elif [ grep -Eo "get" $name != "" ]; then
			tags='"openshmem", "get"'
		elif [ grep -Eo "atomics" $name != "" ]; then
			tags='"openshmem", "atomics"'
		else
			tags='"openshmem", "oshm_collective"'
		fi
		local binary="@BUILDPATH@/c/openshmem/$name"

		# Build step
		echo "compile_osu_openshmem_${name}:"
		echo "  build:"
		echo "    files: '@BUILDPATH@/c/openshmem/Makefile'"
		echo "    make: {'target': '${name}'}"
		echo ""

		echo "${name}:"
		echo "  tag: [$tags]"
		echo "  group: 'GRPMPI'"
		echo "  run:"
		echo "    program: '${binary}'"
		echo "    depends_on:   [ 'compile_osu_openshmem_${name}' ]"
		echo "  validate: {time: {hard_timeout: 600}}"

		echo ""

	done

	cd $pre_testsuite_dir
}

#pre actions...
OLDIR=$(pwd)
cd $pcvs_build_current

#run configure...
$pcvs_src_current/configure CC="$PCVS_CMP_CC" CXX="$PCVS_CMP_CXX" CFLAGS="$PCVS_CMP_CC_ARGS" --prefix=$pcvs_build_current >$pcvs_build_current/configure_out.log 2>&1 || exit 1

mkdir -p $pcvs_build_current/util
cp $pcvs_src_current/c/util/* $pcvs_build_current/c/util/

# MPI Testsuite
mpi_testsuite
openshmem_testsuite

######
cd $OLDIR
exit 0
